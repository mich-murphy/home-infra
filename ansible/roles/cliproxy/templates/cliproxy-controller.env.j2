# Managed by Ansible (cliproxy role).
CPA_BASE_URL=http://127.0.0.1:{{ cliproxy_port }}
# systemd's LoadCredential copy of {{ cliproxy_controller_config_dir }}/management-key.
CPA_MANAGEMENT_KEY_FILE=/run/credentials/cliproxy-controller.service/management-key
# Direct mode: the status API and page answer on the tailnet, admitted only on
# tailscale0, and require the management key with throttled failures.
CONTROLLER_LISTEN={{ cliproxy_controller_listen_host }}:{{ cliproxy_controller_port }}
CONTROLLER_DRY_RUN={{ cliproxy_controller_dry_run | bool | lower }}
{% for name, value in cliproxy_controller_settings | dictsort %}
{% if value | string | length > 0 %}
{{ name }}={{ value }}
{% endif %}
{% endfor %}
